+/* UTM: native GL renders a window drawable in the window's own backing
+ * memory, so binding that backing as a texture (Quartz GL's masked window
+ * self-copy, e.g. behind a pulsing default button) samples the GPU's current
+ * pixels. Here an ordinary drawable is a separate host allocation whose
+ * pixels reach the backing only when presented, so the bind would sample a
+ * stale CPU image. Present this drawable first when the texture being bound
+ * is its own backing; the ordinary refresh below then transfers it. */
+static void VIMSyncSelfSampledBacking(GLIContext ctx,GLuint texture)
+{
+    struct VIMContext *c=(void *)ctx;struct VIMShareGroup *g=c->group;struct VIMCGSDrawable *d=c->drawable;
+    if(!d || d->self_sample_sync || !d->updates || getenv("VIM_GL_DISABLE_SELF_SAMPLE_SYNC"))return;
+    io_connect_t connection=0;
+    pthread_mutex_lock(&g->lock);
+    for(struct VIMCGSTexture *s=g->cgs_textures;s;s=s->next)
+        if(s->texture==texture){if(!s->retired)connection=s->connection;break;}
+    pthread_mutex_unlock(&g->lock);
+    struct VIMSurfaceState sampled={0},drawn={0};
+    if(!connection || !VIMCGSState(connection,&sampled) || !VIMCGSState(d->updates,&drawn) ||
+       !sampled.object || sampled.object!=drawn.object || sampled.incarnation!=drawn.incarnation)return;
+    d->self_sample_sync=1;
+    struct VIMSavedBinding previous=VIMSaveGLI(ctx);
+    if(VIMBindGLI(ctx)){VIMPresentDrawableKnown(ctx,0,0);VIMRestoreGLI(previous,ctx);}
+    else VIMDiscardGLI(previous);
+    d->self_sample_sync=0;
+}
