+/* UTM: period GPUs (Intel Gen in ARB mode, R300) multiply with the DX9 rule
+ * 0 * x = 0, also for x = inf or NaN; Metal-backed host GL follows IEEE, so
+ * 0 * inf gives NaN. Apple's Quartz GL and Core Image programs depend on the
+ * period rule (LG2 of 0, RCP of 0 scaled by a zero weight): the pulsing
+ * default button got a washed-out fill and unsmoothed text. Rewrite MUL, MAD,
+ * DP3 and DP4 so a zero factor gives zero, as UTM's R300 translator does. */
+static int DGARBLegacySplit(const char *s,size_t n,const char **parts,size_t *lens,int max)
+{
+    int count=0,depth=0;size_t start=0;
+    for(size_t i=0;i<=n;++i){
+        char ch=i<n?s[i]:',';
+        if(ch=='{')depth++;else if(ch=='}')depth--;
+        if(ch==','&&depth==0){
+            size_t a=start,b=i;while(a<b&&(s[a]==' '||s[a]=='\t'))a++;while(b>a&&(s[b-1]==' '||s[b-1]=='\t'))b--;
+            if(count>=max||a==b)return -1;parts[count]=s+a;lens[count]=b-a;count++;start=i+1;
+        }
+    }
+    return depth?-1:count;
+}
+static char *DGARBLegacyMultiply(const char *source,size_t length,size_t *out_length)
+{
+    if(length<10||memcmp(source,"!!ARBfp1.0",10))return NULL;
+    size_t capacity=length*8+256,used=0;int declared=0,changed=0;
+    char *out=malloc(capacity);if(!out)return NULL;
+#define DG_EMIT(...) do{int w=snprintf(out+used,capacity-used,__VA_ARGS__);if(w<0||(size_t)w>=capacity-used){free(out);return NULL;}used+=(size_t)w;}while(0)
+    size_t i=0;
+    while(i<length){
+        size_t e=i;while(e<length&&source[e]!='\n')e++;
+        const char *line=source+i;size_t n=e-i;size_t k=0;while(k<n&&(line[k]==' '||line[k]=='\t'))k++;
+        int op=-1;static const char *names[]={"MUL","MAD","DP3","DP4"};
+        for(int j=0;j<4&&op<0;++j)if(n-k>4&&!memcmp(line+k,names[j],3))op=j;
+        const char *semi=op>=0?memchr(line,';',n):NULL;
+        int ok=0;
+        if(semi&&!memchr(line,'#',n)&&memchr(semi+1,';',(size_t)(line+n-semi-1))==NULL){
+            size_t m=k+3;int sat=0;
+            if(n-m>4&&!memcmp(line+m,"_SAT",4)){sat=1;m+=4;}
+            if(m<n&&(line[m]==' '||line[m]=='\t')){
+                const char *parts[4];size_t lens[4];
+                int count=DGARBLegacySplit(line+m,(size_t)(semi-line-m),parts,lens,4);
+                if(count==(op==1?4:3)){
+                    if(!declared){DG_EMIT("TEMP vimlm0, vimlm1, vimlm2;\n");declared=1;}
+                    const char *z="{0.0,0.0,0.0,0.0}";
+                    DG_EMIT("MUL vimlm0, %.*s, %.*s;\nABS vimlm1, %.*s;\nSGE vimlm1, -vimlm1, %s;\n"
+                            "ABS vimlm2, %.*s;\nSGE vimlm2, -vimlm2, %s;\nMAX vimlm1, vimlm1, vimlm2;\n",
+                            (int)lens[1],parts[1],(int)lens[2],parts[2],(int)lens[1],parts[1],z,(int)lens[2],parts[2],z);
+                    if(op==0)DG_EMIT("CMP%s %.*s, -vimlm1, %s, vimlm0;\n",sat?"_SAT":"",(int)lens[0],parts[0],z);
+                    else{
+                        DG_EMIT("CMP vimlm0, -vimlm1, %s, vimlm0;\n",z);
+                        if(op==1)DG_EMIT("ADD%s %.*s, vimlm0, %.*s;\n",sat?"_SAT":"",(int)lens[0],parts[0],(int)lens[3],parts[3]);
+                        else DG_EMIT("%s%s %.*s, vimlm0, {1.0,1.0,1.0,1.0};\n",names[op],sat?"_SAT":"",(int)lens[0],parts[0]);
+                    }
+                    ok=1;changed=1;
+                }
+            }
+        }
+        if(!ok)DG_EMIT("%.*s%s",(int)n,line,e<length?"\n":"");
+        i=e<length?e+1:e;
+    }
+#undef DG_EMIT
+    if(!changed){free(out);return NULL;}
+    *out_length=used;return out;
+}
+static void DGHostARBProgramStringNative(struct DGHostContext *c,GLenum target,GLenum format,GLsizei length,const void *source);
 static void DGHostARBProgramString(struct DGHostContext *c,GLenum target,GLenum format,GLsizei length,const void *source)
 {
+    char *legacy=NULL;size_t legacy_length=0;
+    if(target==GL_FRAGMENT_PROGRAM_ARB&&format==GL_PROGRAM_FORMAT_ASCII_ARB&&length>0&&!c->inside_begin&&(uint32_t)length<=262144)
+        legacy=DGARBLegacyMultiply(source,(size_t)length,&legacy_length);
+    if(legacy){
+        // Keep the caller's program if the rewrite doesn't compile on this host.
+        GLenum prior=glGetError();if(prior&&!c->error)c->error=prior;
+        glProgramStringARB(target,format,(GLsizei)legacy_length,legacy);
+        if(glGetError()){free(legacy);legacy=NULL;}
+    }
+    DGHostARBProgramStringNative(c,target,format,legacy?(GLsizei)legacy_length:length,legacy?legacy:source);
+    free(legacy);
+}
+static void DGHostARBProgramStringNative(struct DGHostContext *c,GLenum target,GLenum format,GLsizei length,const void *source)
+{
     if(c->inside_begin || target!=GL_FRAGMENT_PROGRAM_ARB || format!=GL_PROGRAM_FORMAT_ASCII_ARB || length<=0 || !DGHostARBUsesHardware()){
         glProgramStringARB(target,format,length,source);return;
     }
